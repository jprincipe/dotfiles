# themes
theme = "catppuccin-frappe"
# theme = "nordic"
# theme = "kanagawa"
# background = "#2A2A37"
# theme = everforest-dark
selection-background = #8caaee
selection-foreground = #303446
# background-opacity = 0.95
# background-blur-radius = 10
# alpha-blending = linear-corrected

# macos-icon = official
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/nord.icns

# font settings
# font-family = "Iosevka NF"
# font-family = "MonaspaceRadonNF"
# font-family = "MonoLisaCode"
# font-family-italic = "MonoLisaCode"
# font-family-bold-italic = "MonoLisaCode"
font-family = "Maple Mono NF"
font-family-italic = "Maple Mono NF"
font-family-bold-italic = "Maple Mono NF"
font-size = 12
font-thicken = true
# MonoLisa v3 features: ss01 script italics, ss08 alt $, ss11 alt {}
# (coding ligatures stay off — add dlig to enable them all)
# font-feature = ss01
# font-feature = ss08
# font-feature = ss11
# Maple Mono features
font-feature = calt
font-feature = cv01
font-feature = ss01
font-feature = ss02
font-feature = ss08
font-feature = zero

# clipboard settings
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
scrollback-limit = 10000000

# window settings
macos-non-native-fullscreen = true
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
window-save-state = always
window-colorspace = "display-p3"
window-inherit-font-size = false
window-padding-x = 0
window-padding-y = 0
# Split the leftover sub-cell space evenly instead of dumping it bottom/right.
window-padding-balance = true
window-title-font-family = "Maple Mono NF"
mouse-hide-while-typing = true

# quick terminal
# quick-terminal-position = center
# quick-terminal-size = 75%,75%
# quick-terminal-animation-duration = 0
# quick-terminal-autohide = false

# keybinds
macos-option-as-alt = true
# keybind = global:super+/=toggle_quick_terminal
keybind = shift+enter=text:\n

# use dev builds
# auto-update-channel = tip

# cursor settings
cursor-style = block
cursor-color = #e5c890
cursor-opacity = 1.0
cursor-invert-fg-bg = false

# shaders
custom-shader-animation = always
# custom-shader=./shaders/cursor_sweep.glsl
# NOTE: `custom-shader` is a repeatable key -- every uncommented line stacks, so
# leaving two enabled runs both effects at once.
# Tail only: cursor_warp draws the trail. ripple_cursor stays off.
custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/ripple_cursor.glsl
# custom-shader=./shaders/cursor_smear_fade.glsl
# custom-shader=./shaders/cursor_blaze.glsl
# custom-shader=./shaders/cursor_blaze_tapered.glsl
# custom-shader=./shaders/cursor_smear.glsl

